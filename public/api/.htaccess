<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Allow direct access to physical files (like upload.php, config.php)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all API endpoint requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
